+					Content: []format.CoreContentBlock{
+						{
+							Type: "tool_use", ToolUseID: "toolu_visual", ToolName: ToolVisualBrief,
+							ToolInput: json.RawMessage(`{"image_refs":["Image #1"],"context":"read the status"}`),
+						},
+						{
+							Type: "tool_use", ToolUseID: "toolu_lookup_early", ToolName: "lookup_ticket",
+							ToolInput: json.RawMessage(`{"id":"731"}`),
+						},
+					},
+				}},
+			},
+			{
+				ID: "msg_client_tool", Status: "completed", StopReason: "tool_use",
+				Messages: []format.CoreMessage{{
+					Role: "assistant",
+					Content: []format.CoreContentBlock{{
+						Type: "tool_use", ToolUseID: "toolu_lookup_final", ToolName: "lookup_ticket",
+						ToolInput: json.RawMessage(`{"id":"731","visual_status":"ready"}`),
+					}},
+				}},
+			},
+		},
+	}
+	vision := &fakeCoreVisionClient{text: "status is ready"}
+	orchestrator := NewCoreOrchestrator(CoreOrchestratorConfig{
+		Upstream:  upstream,
+		Client:    vision,
+		MaxRounds: 3,
+	})
+
+	resp, err := orchestrator.CreateCore(context.Background(), &format.CoreRequest{
+		Model: "test-model",
+		Messages: []format.CoreMessage{{
+			Role: "user",
+			Content: []format.CoreContentBlock{
+				{Type: "text", Text: "inspect then look up"},
+				{Type: "image", ImageData: "abc123", MediaType: "image/png"},
+			},
+		}},
+		Tools: []format.CoreTool{
+			{Name: ToolVisualBrief},
+			{Name: "lookup_ticket"},
+		},
+		ToolChoice: &format.CoreToolChoice{Mode: "required"},
+	})
+	if err != nil {
+		t.Fatalf("CreateCore() error = %v", err)
+	}
+	if resp.ID != "msg_client_tool" {
+		t.Fatalf("response ID = %q, want msg_client_tool", resp.ID)
+	}
+	if len(vision.requests) != 1 {
+		t.Fatalf("vision requests = %d, want 1", len(vision.requests))
+	}
+	if len(upstream.requests) != 2 {
+		t.Fatalf("upstream requests = %d, want 2", len(upstream.requests))
+	}
+
+	followUp := upstream.requests[1]
+	if followUp.ToolChoice == nil || followUp.ToolChoice.Mode != "auto" {
+		t.Fatalf("follow-up tool choice = %+v, want auto", followUp.ToolChoice)
+	}
+	for _, msg := range followUp.Messages {
+		for _, block := range msg.Content {
+			if block.Type == "tool_use" && block.ToolName == "lookup_ticket" {
+				t.Fatalf("unresolved client tool leaked into visual history: %+v", block)
+			}
+		}
+	}
+	last := followUp.Messages[len(followUp.Messages)-1]
+	if last.Role != "tool" || len(last.Content) != 1 || last.Content[0].ToolUseID != "toolu_visual" {
+		t.Fatalf("visual result history = %+v", followUp.Messages)
+	}
