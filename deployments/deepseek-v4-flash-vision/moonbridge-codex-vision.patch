+func TestModelsCatalogReturnsCodexMetadata(t *testing.T) {
+	cfg := minimalRuntimeConfig()
+	rt := runtime.NewRuntime(cfg, nil, nil)
+	handler := server.New(server.Config{
+		ServerCfg: config.ServerConfig{AuthToken: "my-secret"},
+		Runtime:   rt,
+	})
+
+	recorder := httptest.NewRecorder()
+	request := httptest.NewRequest(http.MethodGet, "/v1/models", nil)
+	request.Header.Set("Authorization", "Bearer my-secret")
+	handler.ServeHTTP(recorder, request)
+	if recorder.Code != http.StatusOK {
+		t.Fatalf("/v1/models status = %d, body = %s", recorder.Code, recorder.Body.String())
+	}
+	var response struct {
+		Models []codex.ModelInfo `json:"models"`
+	}
+	if err := json.NewDecoder(recorder.Body).Decode(&response); err != nil {
+		t.Fatalf("decode models response: %v", err)
+	}
+	if len(response.Models) != 1 {
+		t.Fatalf("models = %d, want 1: %+v", len(response.Models), response.Models)
+	}
+	model := response.Models[0]
+	if model.Slug != "test-model" || model.DisplayName != "Test Model" {
+		t.Fatalf("model identity = %+v", model)
+	}
+	if model.InputModalities == nil || model.SupportedReasoningLevels == nil {
+		t.Fatalf("model is missing required Codex metadata: %+v", model)
+	}
+}
